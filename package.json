{
  "name": "playwright-ecommerce-automation",
  "version": "1.0.0",
  "description": "E-commerce automation testing project using Playwright and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:login": "playwright test tests/login.spec.ts",
    "test:products": "playwright test tests/products.spec.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "qa",
    "testing"
  ],
  "author": "Ritik",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
